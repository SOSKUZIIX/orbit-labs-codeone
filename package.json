{
  "name": "codeone",
  "version": "0.1.0-beta.1",
  "description": "CodeOne by Orbit Labs — a multi-provider AI coding workspace",
  "main": "./out/main/index.js",
  "author": "Orbit Labs",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "release:assets": "node scripts/prepare-release-assets.mjs",
    "package:mac": "npm run build && electron-builder --mac --config electron-builder.yml",
    "package:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "package:all": "npm run build && electron-builder --mac --win --config electron-builder.yml",
    "start": "electron-vite preview"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.52.0",
    "node-pty": "^1.1.0",
    "react-resizable-panels": "^2.1.7"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
