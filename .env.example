# CodeOne development environment
#
# Copy this file to ".env" in the project root and fill in the values you need.
#
# .env is gitignored. Never commit real keys.

# Offline local runtime (optional). Must resolve to loopback (127.0.0.1 /
# localhost / ::1); non-loopback values are refused. Defaults to Ollama.
# ORBIT_LOCAL_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions

# Optional cloud provider keys (opt-in; the app is offline-first).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
